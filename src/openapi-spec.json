{
  "openapi": "3.0.0",
  "paths": {
    "/v1/chat/completions": {
      "post": {
        "operationId": "createCompletion",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatCompletionRequestDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatCompletionResponseDto"
                }
              }
            }
          }
        },
        "summary": "Create a chat completion",
        "tags": [
          "chat"
        ]
      }
    },
    "/v1/models": {
      "get": {
        "operationId": "listModels",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModelsListResponseDto"
                }
              }
            }
          }
        },
        "summary": "List available models",
        "tags": [
          "models"
        ]
      }
    },
    "/v1/images/generations": {
      "post": {
        "operationId": "generateImage",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ImageGenerationRequestDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ImageGenerationResponseDto"
                }
              }
            }
          },
          "500": {
            "description": "ComfyUI unavailable or generation failed"
          }
        },
        "summary": "Generate an image using the zib-zit-moody ComfyUI workflow",
        "tags": [
          "images"
        ]
      }
    },
    "/v1/audio/transcriptions": {
      "post": {
        "operationId": "transcribe",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "file"
                ],
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary",
                    "description": "Audio file to transcribe"
                  },
                  "model": {
                    "type": "string",
                    "description": "Whisper model name (legacy=true only)",
                    "example": "Systran/faster-whisper-small"
                  },
                  "language": {
                    "type": "string",
                    "description": "ISO 639-1 language code",
                    "example": "en"
                  },
                  "diarization": {
                    "type": "boolean",
                    "description": "Enable speaker diarization — returns verbose_json with per-segment speaker labels. Mutually exclusive with legacy.",
                    "default": false
                  },
                  "legacy": {
                    "type": "boolean",
                    "description": "Use legacy speaches (faster-whisper) backend. Returns plain {text}. Mutually exclusive with diarization.",
                    "default": false
                  },
                  "min_speakers": {
                    "type": "integer",
                    "description": "Minimum speaker count hint (diarization=true only)",
                    "example": 2
                  },
                  "max_speakers": {
                    "type": "integer",
                    "description": "Maximum speaker count hint (diarization=true only)",
                    "example": 3
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Plain {text} by default or with legacy=true; verbose response with speaker segments when diarization=true",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/AudioTranscriptionResponseDto"
                    },
                    {
                      "$ref": "#/components/schemas/AudioTranscriptionVerboseResponseDto"
                    }
                  ]
                }
              }
            }
          },
          "500": {
            "description": "Transcription failed"
          }
        },
        "summary": "Transcribe audio. Default: transcribe-audio (Whisper large-v3). legacy=true: speaches. diarization=true: transcribe-audio with speaker labels.",
        "tags": [
          "audio"
        ]
      }
    },
    "/v1/audio/voices": {
      "get": {
        "operationId": "listVoices",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Array of available voices with id, language, and gender"
          }
        },
        "summary": "List voices available from the Chatterbox TTS engine",
        "tags": [
          "audio"
        ]
      }
    },
    "/v1/audio/speech": {
      "post": {
        "operationId": "speak",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AudioSpeechRequestDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Binary audio body",
            "content": {
              "audio/wav": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "400": {
            "description": "Missing or invalid input"
          },
          "404": {
            "description": "Unknown voice"
          },
          "500": {
            "description": "Speech synthesis failed"
          }
        },
        "summary": "Generate speech audio from text (default: Chatterbox WAV; legacy:true → speaches MP3)",
        "tags": [
          "audio"
        ]
      }
    },
    "/v1/audio/speech/stream": {
      "post": {
        "operationId": "speakStream",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AudioSpeechRequestDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "SSE stream of audio chunks",
            "content": {
              "text/event-stream": {
                "schema": {
                  "$ref": "#/components/schemas/AudioSpeechStreamChunkDto"
                }
              }
            }
          }
        },
        "summary": "Generate speech audio sentence-by-sentence over SSE (default: Chatterbox; legacy:true → speaches)",
        "tags": [
          "audio"
        ]
      }
    },
    "/v1/videos/generations": {
      "post": {
        "operationId": "generateVideo",
        "parameters": [],
        "responses": {
          "501": {
            "description": "Not implemented"
          }
        },
        "summary": "Video generation (not implemented — stub 501)",
        "tags": [
          "videos"
        ]
      }
    }
  },
  "info": {
    "title": "AI Proxy API",
    "description": "OpenAI-compatible proxy for llama.cpp with context compression, retry, and tool-call buffering",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "FunctionCallDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "arguments": {
            "type": "string"
          }
        },
        "required": [
          "name"
        ]
      },
      "ToolCallDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "example": "function"
          },
          "function": {
            "$ref": "#/components/schemas/FunctionCallDto"
          }
        },
        "required": [
          "id",
          "type",
          "function"
        ]
      },
      "ChatMessageDto": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "example": "user",
            "description": "Role of the message sender: system, user, assistant, or tool"
          },
          "content": {
            "type": "string",
            "description": "Message content (string for text, array for multimodal/vision)"
          },
          "tool_calls": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ToolCallDto"
            }
          },
          "tool_call_id": {
            "type": "string"
          },
          "reasoning_content": {
            "type": "string",
            "description": "Reasoning content from llama.cpp thinking models (non-standard OpenAI field)"
          }
        },
        "required": [
          "role"
        ]
      },
      "ToolFunctionDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "parameters": {
            "type": "object"
          }
        },
        "required": [
          "name"
        ]
      },
      "ToolDefinitionDto": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "example": "function"
          },
          "function": {
            "$ref": "#/components/schemas/ToolFunctionDto"
          }
        },
        "required": [
          "type",
          "function"
        ]
      },
      "CompressionOptionsDto": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean",
            "description": "Enable context compression before forwarding to llama.cpp"
          },
          "maxContextSize": {
            "type": "number",
            "description": "Maximum context size in tokens. Older messages are evicted when exceeded."
          }
        }
      },
      "ChatCompletionRequestDto": {
        "type": "object",
        "properties": {
          "messages": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ChatMessageDto"
            }
          },
          "model": {
            "type": "string"
          },
          "temperature": {
            "type": "number"
          },
          "stream": {
            "type": "boolean"
          },
          "tools": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ToolDefinitionDto"
            }
          },
          "tool_choice": {
            "type": "object"
          },
          "max_tokens": {
            "type": "number"
          },
          "compressionOptions": {
            "description": "Proxy extension: context compression options",
            "allOf": [
              {
                "$ref": "#/components/schemas/CompressionOptionsDto"
              }
            ]
          },
          "awaitToolCallCompletion": {
            "type": "boolean",
            "description": "Proxy extension: buffer all tool-call deltas before sending to client (only meaningful when stream=true)"
          },
          "disableThinking": {
            "type": "boolean",
            "description": "Proxy extension: disable thinking/reasoning for llama.cpp models that support it (defaults to false)"
          }
        },
        "required": [
          "messages"
        ]
      },
      "ChatChoiceDto": {
        "type": "object",
        "properties": {
          "index": {
            "type": "number"
          },
          "message": {
            "$ref": "#/components/schemas/ChatMessageDto"
          },
          "finish_reason": {
            "type": "string"
          }
        },
        "required": [
          "index",
          "message"
        ]
      },
      "UsageDto": {
        "type": "object",
        "properties": {
          "prompt_tokens": {
            "type": "number"
          },
          "completion_tokens": {
            "type": "number"
          },
          "total_tokens": {
            "type": "number"
          }
        },
        "required": [
          "prompt_tokens",
          "completion_tokens",
          "total_tokens"
        ]
      },
      "ChatCompletionResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "object": {
            "type": "string",
            "example": "chat.completion"
          },
          "created": {
            "type": "number"
          },
          "model": {
            "type": "string"
          },
          "choices": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ChatChoiceDto"
            }
          },
          "usage": {
            "$ref": "#/components/schemas/UsageDto"
          }
        },
        "required": [
          "id",
          "object",
          "created",
          "model",
          "choices"
        ]
      },
      "ModelObjectDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "local-model"
          },
          "object": {
            "type": "string",
            "example": "model"
          },
          "created": {
            "type": "number"
          },
          "owned_by": {
            "type": "string",
            "example": "llama.cpp"
          }
        },
        "required": [
          "id",
          "object",
          "created",
          "owned_by"
        ]
      },
      "ModelsListResponseDto": {
        "type": "object",
        "properties": {
          "object": {
            "type": "string",
            "example": "list"
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ModelObjectDto"
            }
          }
        },
        "required": [
          "object",
          "data"
        ]
      },
      "ImageGenerationRequestDto": {
        "type": "object",
        "properties": {
          "prompt": {
            "type": "string",
            "description": "Text prompt for image generation"
          },
          "negativePrompt": {
            "type": "string",
            "description": "Proxy extension: negative prompt for things to avoid in the image"
          },
          "model": {
            "type": "string",
            "description": "Model name (currently always maps to zib-zit-moody workflow)"
          },
          "n": {
            "type": "number",
            "description": "Number of images to generate (currently only 1 is supported)",
            "example": 1
          },
          "size": {
            "type": "string",
            "description": "Image size as WxH string",
            "example": "1024x1024"
          },
          "response_format": {
            "type": "string",
            "description": "Response format",
            "example": "b64_json",
            "enum": [
              "url",
              "b64_json"
            ]
          },
          "quality": {
            "type": "string",
            "description": "Image quality hint (ignored, passed through)",
            "example": "standard"
          },
          "style": {
            "type": "string",
            "description": "Image style hint (ignored, passed through)",
            "example": "vivid"
          }
        },
        "required": [
          "prompt"
        ]
      },
      "ImageDataDto": {
        "type": "object",
        "properties": {
          "b64_json": {
            "type": "string",
            "description": "Base64-encoded image data"
          },
          "url": {
            "type": "string",
            "description": "URL of the generated image"
          },
          "revised_prompt": {
            "type": "string",
            "description": "The revised prompt used for generation"
          }
        }
      },
      "ImageGenerationResponseDto": {
        "type": "object",
        "properties": {
          "created": {
            "type": "number",
            "description": "Unix timestamp of when the request was made"
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ImageDataDto"
            }
          }
        },
        "required": [
          "created",
          "data"
        ]
      },
      "AudioTranscriptionResponseDto": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "description": "The transcribed text"
          }
        },
        "required": [
          "text"
        ]
      },
      "TranscriptionSegmentDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number",
            "description": "Segment index"
          },
          "start": {
            "type": "number",
            "description": "Segment start time in seconds"
          },
          "end": {
            "type": "number",
            "description": "Segment end time in seconds"
          },
          "text": {
            "type": "string",
            "description": "Transcribed text for this segment"
          },
          "speaker": {
            "type": "string",
            "description": "Speaker identifier",
            "example": "SPEAKER_00"
          }
        },
        "required": [
          "id",
          "start",
          "end",
          "text",
          "speaker"
        ]
      },
      "AudioTranscriptionVerboseResponseDto": {
        "type": "object",
        "properties": {
          "task": {
            "type": "string",
            "description": "Task type",
            "example": "transcribe"
          },
          "language": {
            "type": "string",
            "description": "Detected or specified language"
          },
          "duration": {
            "type": "number",
            "description": "Total audio duration in seconds"
          },
          "text": {
            "type": "string",
            "description": "Full concatenated transcript text"
          },
          "segments": {
            "description": "Per-segment transcription with speaker labels",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TranscriptionSegmentDto"
            }
          },
          "speakers": {
            "example": [
              "SPEAKER_00",
              "SPEAKER_01"
            ],
            "description": "All speaker IDs detected in the audio",
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "task",
          "language",
          "duration",
          "text",
          "segments",
          "speakers"
        ]
      },
      "AudioSpeechStreamChunkDto": {
        "type": "object",
        "properties": {
          "audio": {
            "type": "string",
            "description": "Base64-encoded audio buffer for one sentence"
          },
          "sentence": {
            "type": "string",
            "description": "The sentence whose audio is in this chunk"
          }
        },
        "required": [
          "audio",
          "sentence"
        ]
      },
      "AudioSpeechRequestDto": {
        "type": "object",
        "properties": {
          "input": {
            "type": "string",
            "description": "Text to synthesize"
          },
          "model": {
            "type": "string",
            "description": "TTS model to use",
            "example": "hexgrad/Kokoro-82M"
          },
          "voice": {
            "type": "string",
            "description": "Voice to use",
            "example": "af_sky"
          },
          "response_format": {
            "type": "string",
            "description": "Audio format: mp3, wav, flac, opus, aac, pcm",
            "example": "mp3"
          },
          "speed": {
            "type": "number",
            "description": "Speech speed (0.25–4.0)",
            "example": 1
          },
          "exaggeration": {
            "type": "number",
            "description": "Chatterbox cfg_weight (0.0–1.0); only used on the default (non-legacy) path",
            "example": 0.5
          },
          "legacy": {
            "type": "boolean",
            "description": "Route to the legacy speaches backend instead of Chatterbox",
            "example": false
          }
        },
        "required": [
          "input"
        ]
      }
    }
  }
}